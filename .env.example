# TableFlow — valores PÚBLICOS del proyecto Supabase (Settings → API Keys).
# Copia este archivo a `.env` y rellena. No pongas service_role ni sb_secret_* aquí.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx
# Alias opcional (misma clave pública):
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
